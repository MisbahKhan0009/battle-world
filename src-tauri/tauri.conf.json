{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flag Clash",
  "version": "1.0.0",
  "identifier": "com.flagclash.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flag Clash",
        "width": 1360,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Viral game videos, posted to YouTube on autopilot",
    "longDescription": "Flag Clash renders physics game videos (Shorts and long videos) on your computer and posts them to your YouTube channel on an organic schedule. It runs quietly in the system tray.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
